#!/usr/bin/env bash

set -u

SCRIPT_DIR="$(
    cd "$(dirname "${BASH_SOURCE[0]}")"
    pwd
)"

PROJECT_ROOT="$(
    cd "$SCRIPT_DIR/.."
    pwd
)"

LOG_DIR="$PROJECT_ROOT/logs"
RUN_DIR="$PROJECT_ROOT/run"


SERVICES=(
    collector
    geoip
    mfa
    security
    firewall
    storage
    control
    telegram
    api
    panel
)


echo "=========================================="
echo " SSH Guardian — Logs temps réel"
echo "=========================================="
echo


# ============================================================
# DETECTION MODE PROD
# ============================================================

PROD_ACTIVE=0

for service in "${SERVICES[@]}"
do
    if systemctl is-active \
        --quiet \
        "ssh-guardian@${service}.service" \
        2>/dev/null
    then
        PROD_ACTIVE=1
        break
    fi
done


# ============================================================
# MODE PROD / SYSTEMD
# ============================================================

if [ "$PROD_ACTIVE" -eq 1 ]; then

    echo "Mode détecté : 🟢 PROD / systemd"
    echo
    echo "Services :"

    UNITS=()

    for service in "${SERVICES[@]}"
    do
        unit="ssh-guardian@${service}.service"

        LOAD_STATE="$(
            systemctl show \
                "$unit" \
                -p LoadState \
                --value \
                2>/dev/null \
                || true
        )"

        if [ "$LOAD_STATE" != "not-found" ] \
            && [ -n "$LOAD_STATE" ]
        then
            UNITS+=(
                "-u"
                "$unit"
            )
        fi

        if systemctl is-active \
            --quiet \
            "$unit" \
            2>/dev/null
        then
            printf "  ✅ %-12s active\n" "$service"
        else
            printf "  ⚪ %-12s inactive\n" "$service"
        fi
    done

    echo
    echo "Source : systemd / journald"
    echo "Ctrl+C pour quitter"
    echo "------------------------------------------"
    echo

    if [ "${#UNITS[@]}" -eq 0 ]; then
        echo "❌ Aucune unité SSH Guardian trouvée."
        exit 1
    fi

    exec journalctl \
        "${UNITS[@]}" \
        -f \
        -n 30 \
        -o cat
fi


# ============================================================
# DETECTION MODE DEV
# ============================================================

DEV_ACTIVE=0

for service in "${SERVICES[@]}"
do
    PIDFILE="$RUN_DIR/${service}.pid"

    if [ ! -f "$PIDFILE" ]; then
        continue
    fi

    PID="$(
        cat "$PIDFILE" \
        2>/dev/null \
        || true
    )"

    if [ -n "$PID" ] \
        && kill -0 "$PID" 2>/dev/null
    then
        DEV_ACTIVE=1
        break
    fi
done


# ============================================================
# MODE DEV
# ============================================================

if [ "$DEV_ACTIVE" -eq 1 ]; then

    echo "Mode détecté : 🟡 DEV / start-dev.sh"
    echo
    echo "Services :"

    LOG_FILES=()

    for service in "${SERVICES[@]}"
    do
        PIDFILE="$RUN_DIR/${service}.pid"
        LOGFILE="$LOG_DIR/${service}.log"

        ACTIVE=false

        if [ -f "$PIDFILE" ]; then

            PID="$(
                cat "$PIDFILE" \
                2>/dev/null \
                || true
            )"

            if [ -n "$PID" ] \
                && kill -0 "$PID" 2>/dev/null
            then
                ACTIVE=true
            fi
        fi

        if [ "$ACTIVE" = true ]; then
            printf "  ✅ %-12s active\n" "$service"
        else
            printf "  ⚪ %-12s inactive\n" "$service"
        fi

        if [ -f "$LOGFILE" ]; then
            LOG_FILES+=(
                "$LOGFILE"
            )
        fi
    done

    echo
    echo "Source : $LOG_DIR/*.log"
    echo "Ctrl+C pour quitter"
    echo "------------------------------------------"
    echo

    if [ "${#LOG_FILES[@]}" -eq 0 ]; then
        echo "❌ Aucun fichier de log DEV trouvé."
        exit 1
    fi

    exec tail \
        -n 30 \
        -F \
        "${LOG_FILES[@]}"
fi


# ============================================================
# AUCUN MODE ACTIF
# ============================================================

echo "⚪ Aucun service SSH Guardian actif."
echo
echo "Pour démarrer en production :"
echo
echo "  systemctl start ssh-guardian@collector"
echo
echo "Pour démarrer en développement :"
echo
echo "  ./scripts/start-dev.sh"
echo

exit 1
