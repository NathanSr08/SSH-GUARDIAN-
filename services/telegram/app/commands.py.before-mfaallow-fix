    def message(
        self,
        update,
    ):
        message = update.get(
            "message",
            {},
        )

        chat_id = str(
            message.get(
                "chat",
                {},
            ).get(
                "id",
                "",
            )
        )

        if chat_id != str(
            self.telegram.chat_id
        ):
            return

        text = (
            message.get(
                "text",
                "",
            )
            .strip()
        )

        parts = text.split()

        if not parts:
            return

        command = (
            parts[0]
            .split(
                "@",
                1,
            )[0]
            .lower()
        )

        args = parts[1:]

        if command in {
            "/help",
            "/start",
        }:
            self.telegram.send(
                HELP
            )

        elif command in {
            "/mfa",
            "/mfastatus",
        }:
            response = self.mfa_rpc(
                "status"
            )

            if not response.get("ok"):
                self.telegram.send(
                    "❌ Erreur MFA : "
                    + html.escape(
                        str(
                            response.get(
                                "error",
                                "inconnue",
                            )
                        )
                    )
                )
                return

            result = (
                response.get("result")
                or {}
            )

            enabled = bool(
                result.get("enabled")
            )

            bypasses = (
                result.get(
                    "temporary_bypasses"
                )
                or []
            )

            text = (
                "🔐 <b>MFA SSH</b>\n\n"
                f"État : "
                f"{'🟢 ACTIVÉ' if enabled else '🔴 DÉSACTIVÉ'}\n"
                f"⏱ Timeout : "
                f"<b>{result.get('timeout_seconds', '?')} s</b>\n"
                f"🛡 Fail mode : "
                f"<b>{html.escape(str(result.get('fail_mode', '?')))}</b>\n"
                f"🔓 Autorisations temporaires : "
                f"<b>{len(bypasses)}</b>"
            )

            if bypasses:
                text += "\n\n"

                for item in bypasses:
                    ip = html.escape(
                        str(
                            item.get(
                                "ip",
                                "?",
                            )
                        )
                    )

                    ttl = int(
                        item.get(
                            "ttl",
                            0,
                        )
                    )

                    minutes = max(
                        1,
                        (ttl + 59) // 60,
                    )

                    text += (
                        f"• <code>{ip}</code> "
                        f"— {minutes} min\n"
                    )

            keyboard = {
                "inline_keyboard": [
                    [
                        {
                            "text":
                                (
                                    "🔴 Désactiver MFA"
                                    if enabled
                                    else "🟢 Activer MFA"
                                ),
                            "callback_data":
                                (
                                    "mfa_runtime_off"
                                    if enabled
                                    else "mfa_runtime_on"
                                ),
                        }
                    ]
                ]
            }

            self.telegram.send(
                text,
                reply_markup=keyboard,
            )

        elif command == "/mfaon":
            response = self.mfa_rpc(
                "enable"
            )

            self.telegram.send(
                "🟢 <b>MFA SSH activé</b>"
                if response.get("ok")
                else "❌ Impossible d'activer le MFA."
            )

        elif command == "/mfaoff":
            response = self.mfa_rpc(
                "disable"
            )

            self.telegram.send(
                "🔴 <b>MFA SSH désactivé</b>"
                if response.get("ok")
                else "❌ Impossible de désactiver le MFA."
            )

        elif command == "/mfatimeout":
            if not args:
                self.telegram.send(
                    "⏱ <b>Timeout MFA</b>\n\n"
                    "Usage : "
                    "<code>/mfatimeout 60</code>\n\n"
                    "Minimum : <b>10 secondes</b>\n"
                    "Maximum : <b>300 secondes</b>"
                )
                return

            try:
                seconds = int(
                    args[0]
                )

            except ValueError:
                self.telegram.send(
                    "❌ Timeout invalide.\n\n"
                    "Exemple : "
                    "<code>/mfatimeout 60</code>"
                )
                return

            response = self.mfa_rpc(
                "set_timeout",
                timeout_seconds=seconds,
            )

            if response.get("ok"):
                result = (
                    response.get("result")
                    or {}
                )

                self.telegram.send(
                    "✅ <b>Timeout MFA modifié</b>\n\n"
                    f"⏱ Nouveau timeout : "
                    f"<b>{result.get('timeout_seconds', seconds)} secondes</b>"
                )

            else:
                self.telegram.send(
                    "❌ "
                    + html.escape(
                        str(
                            response.get(
                                "error",
                                "Erreur MFA",
                            )
                        )
                    )
                )

        elif command == "/mfaallow":
            if not args:
                self.telegram.send(
                    "🔓 <b>Autorisation MFA temporaire</b>\n\n"
                    "Usage :\n"
                    "<code>/mfaallow IP 15m</code>\n"
                    "<code>/mfaallow IP 1h</code>\n"
                    "<code>/mfaallow IP 8h</code>\n"
                    "<code>/mfaallow IP 1d</code>"
                )
                return

            ip = args[0]

            duration = 3600

            if len(args) > 1:
                try:
                    duration = parse_duration(
                        args[1]
                    )

                except ValueError:
                    self.telegram.send(
                        "❌ Durée invalide.\n\n"
                        "Formats acceptés :\n"
                        "<code>30s</code>\n"
                        "<code>15m</code>\n"
                        "<code>1h</code>\n"
                        "<code>8h</code>\n"
                        "<code>1d</code>"
                    )
                    return

            response = self.mfa_rpc(
                "allow_ip",
                ip=ip,
                duration=duration,
            )

            if response.get("ok"):
                if duration >= 86400:
                    duration_text = (
                        f"{round(duration / 86400, 2)} j"
                    )

                elif duration >= 3600:
                    duration_text = (
                        f"{round(duration / 3600, 2)} h"
                    )

                elif duration >= 60:
                    duration_text = (
                        f"{round(duration / 60, 2)} min"
                    )

                else:
                    duration_text = (
                        f"{duration} s"
                    )

                self.telegram.send(
                    "🔓 <b>Autorisation MFA temporaire</b>

"
                    f"🌐 IP : <code>{html.escape(ip)}</code>
"
                    f"⏱ Durée : <b>{duration_text}</b>

"
                    "Les prochaines connexions depuis cette IP "
                    "ne demanderont pas de validation MFA "
                    "pendant cette durée."
                )

            else:
                self.telegram.send(
                    "❌ "
                    + html.escape(
                        str(
                            response.get(
                                "error",
                                "Impossible d'ajouter l'autorisation.",
                            )
                        )
                    )
                )

        elif command == "/mfarevoke":
            if not args:
                self.telegram.send(
                    "⚠️ /mfarevoke &lt;ip&gt;"
                )
                return

            response = self.mfa_rpc(
                "revoke_ip",
                ip=args[0],
            )

            self.telegram.send(
                "🔒 <b>Bypass MFA supprimé</b>\n\n"
                f"🌐 IP : "
                f"<code>{html.escape(args[0])}</code>"
                if response.get("ok")
                else "❌ Impossible de supprimer le bypass."
            )

        elif command == "/stats":
            self.send_rpc(
                "stats"
            )

        elif command == "/top":
            self.send_rpc(
                "top"
            )

        elif command in {
            "/topcountries",
            "/top-pays",
        }:
            self.send_rpc(
                "topcountries"
            )

        elif command == "/search":
            if not args:
                self.telegram.send(
                    "⚠️ /search &lt;ip&gt;"
                )
            else:
                self.send_rpc(
                    "search",
                    [args[0]],
                )

        elif command == "/bans":
            self.send_rpc(
                "bans"
            )

        elif command == "/unban":
            if not args:
                self.telegram.send(
                    "⚠️ /unban &lt;ip&gt;"
                )
            else:
                self.send_rpc(
                    "unban",
                    [args[0]],
                )

        elif command == "/sessions":
            self.send_rpc(
                "sessions"
            )

        elif command == "/active":
            self.send_rpc(
                "active"
            )

        elif command == "/stream":
            if not args:
                self.telegram.send(
                    "⚠️ /stream "
                    "&lt;id&gt; [lignes]"
                )

                return

            max_lines = 10

            if (
                len(args) > 1
                and args[1].isdigit()
            ):
                max_lines = min(
                    int(args[1]),
                    100,
                )

            self.start_stream(
                args[0],
                max_lines,
            )

        elif command == "/killsession":
            if not args:
                self.telegram.send(
                    "⚠️ /killsession "
                    "&lt;PID&gt;"
                )
            else:
                self.send_rpc(
                    "killsession",
                    [args[0]],
                )

        elif command in {
            "/killallsessions",
            "/kill-all-sessions",
        }:
            self.send_rpc(
                "killallsessions"
            )

        elif command == "/block":
            if not args:
                self.telegram.send(
                    "⚠️ /block "
                    "&lt;pays&gt;"
                )
            else:
                self.send_rpc(
                    "block",
                    [args[0]],
                )

        elif command == "/unblock":
            if not args:
                self.telegram.send(
                    "⚠️ /unblock "
                    "&lt;pays&gt;"
                )
            else:
                self.send_rpc(
                    "unblock",
                    [args[0]],
                )

        elif command == "/countries":
            self.send_rpc(
                "countries"
            )

        else:
            self.telegram.send(
                "❓ Commande inconnue.\n\n"
                + HELP
            )
