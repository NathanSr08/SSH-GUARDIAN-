def parse_duration(value):
    value = str(
        value
    ).strip().lower()

    if value.isdigit():
        return int(value)

    units = {
        "s": 1,
        "m": 60,
        "h": 3600,
        "d": 86400,
    }

    if (
        len(value) >= 2
        and value[-1] in units
        and value[:-1].isdigit()
    ):
        return (
            int(value[:-1])
            * units[value[-1]]
        )

    raise ValueError(
        "Durée invalide"
    )


