                data.split(
                    ":",
                    1,
                )[1]
            )

            response = self.mfa_rpc(
                "approve_temporary",
                mfa_request_id,
                timeout=5,
                duration=3600,
            )

            if not response.get("ok"):
                error = html.escape(
                    str(
