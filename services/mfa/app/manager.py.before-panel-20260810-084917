import json
import secrets
from datetime import (
    datetime,
    timedelta,
    timezone,
)

from services.mfa.app.models import (
    MFARequest,
)


class MFAError(Exception):
    pass


class MFARequestNotFound(MFAError):
    pass


class MFARequestExpired(MFAError):
    pass


class MFARequestAlreadyDecided(MFAError):
    pass


class MFAManager:
    KEY_PREFIX = "mfa:request:"

    def __init__(
        self,
        redis_client,
        timeout_seconds: int = 45,
    ):
        self.redis = redis_client

        self.timeout_seconds = (
            timeout_seconds
        )

    def _key(
        self,
        request_id: str,
    ) -> str:
        return (
            f"{self.KEY_PREFIX}"
            f"{request_id}"
        )

    def _now(self) -> datetime:
        return datetime.now(
            timezone.utc
        )

    def create_request(
        self,
        username: str,
        ip: str,
        country: str | None = None,
        country_code: str | None = None,
        city: str | None = None,
        isp: str | None = None,
    ) -> MFARequest:

        now = self._now()

        request_id = secrets.token_urlsafe(
            18
        )

        request = MFARequest(
            request_id=request_id,
            username=username,
            ip=ip,
            status="pending",
            created_at=now,
            expires_at=(
                now
                + timedelta(
                    seconds=
                        self.timeout_seconds
                )
            ),
            country=country,
            country_code=country_code,
            city=city,
            isp=isp,
        )

        key = self._key(
            request_id
        )

        self.redis.set(
            key,
            json.dumps(
                request.to_dict()
            ),
            ex=(
                self.timeout_seconds
                + 60
            ),
        )

        return request

    def get_request(
        self,
        request_id: str,
    ) -> MFARequest:

        raw = self.redis.get(
            self._key(
                request_id
            )
        )

        if not raw:
            raise MFARequestNotFound(
                "Demande MFA introuvable."
            )

        if isinstance(
            raw,
            bytes,
        ):
            raw = raw.decode(
                "utf-8"
            )

        request = MFARequest.from_dict(
            json.loads(raw)
        )

        if (
            request.status
            == "pending"
            and self._now()
            >= request.expires_at
        ):
            request.status = "expired"

            self._save(
                request
            )

        return request

    def _save(
        self,
        request: MFARequest,
    ) -> None:

        key = self._key(
            request.request_id
        )

        ttl = self.redis.ttl(
            key
        )

        if ttl is None or ttl <= 0:
            ttl = 60

        self.redis.set(
            key,
            json.dumps(
                request.to_dict()
            ),
            ex=ttl,
        )

    def approve(
        self,
        request_id: str,
        source: str = "telegram",
    ) -> MFARequest:

        request = self.get_request(
            request_id
        )

        if request.status == "expired":
            raise MFARequestExpired(
                "La demande MFA a expiré."
            )

        if request.status != "pending":
            raise MFARequestAlreadyDecided(
                (
                    "La demande MFA a déjà "
                    f"été traitée : "
                    f"{request.status}"
                )
            )

        request.status = "approved"
        request.decided_at = self._now()
        request.decision_source = source

        self._save(
            request
        )

        return request

    def deny(
        self,
        request_id: str,
        source: str = "telegram",
    ) -> MFARequest:

        request = self.get_request(
            request_id
        )

        if request.status == "expired":
            raise MFARequestExpired(
                "La demande MFA a expiré."
            )

        if request.status != "pending":
            raise MFARequestAlreadyDecided(
                (
                    "La demande MFA a déjà "
                    f"été traitée : "
                    f"{request.status}"
                )
            )

        request.status = "denied"
        request.decided_at = self._now()
        request.decision_source = source

        self._save(
            request
        )

        return request

    def cancel(
        self,
        request_id: str,
        source: str = "system",
    ) -> MFARequest:

        request = self.get_request(
            request_id
        )

        if request.status != "pending":
            raise MFARequestAlreadyDecided(
                (
                    "La demande MFA a déjà "
                    f"été traitée : "
                    f"{request.status}"
                )
            )

        request.status = "cancelled"
        request.decided_at = self._now()
        request.decision_source = source

        self._save(
            request
        )

        return request
