<!doctype html>

<html lang="fr">

<head>
<meta charset="utf-8">

<meta
    name="viewport"
    content="width=device-width,initial-scale=1"
>

<title>SSH Guardian</title>

<link
    rel="stylesheet"
    href="/static/styles.css"
>

</head>

<body>


<div id="login" class="login">

    <div class="login-box">

        <h1>🛡 SSH Guardian</h1>

        <p>Security Operations Center</p>

        <input
            id="token"
            type="password"
            placeholder="Token administrateur"
        >

        <button onclick="login()">
            Connexion
        </button>

    </div>

</div>


<div id="app" class="hidden">


<header>

    <div>
        <h1>🛡 SSH Guardian</h1>

        <span class="subtitle">
            Security Operations Center
        </span>
    </div>

    <div id="global-status">
        Chargement...
    </div>

</header>


<main>


<section
    id="stats"
    class="stats"
></section>


<section class="grid">

<article>

    <h2>⚙️ Services</h2>

    <div id="services"></div>

</article>


<article>

    <h2>🌍 Pays bloqués</h2>

    <div class="country-form">

        <input
            id="country"
            maxlength="2"
            placeholder="IT"
        >

        <button onclick="blockCountry()">
            Bloquer
        </button>

    </div>

    <div id="countries"></div>

</article>

</section>


<section>

<article>

    <div class="section-header">

        <h2>🖥 Sessions SSH actives</h2>

        <button
            class="danger"
            onclick="killAllSessions()"
        >
            ⚡ Kill toutes
        </button>

    </div>

    <div id="sessions"></div>

</article>

</section>


<section>

<article>

    <h2>🔎 Recherche IP</h2>

    <div class="search-form">

        <input
            id="search-ip"
            placeholder="1.2.3.4"
        >

        <button onclick="searchIP()">
            Rechercher
        </button>

    </div>

    <div id="search-results"></div>

</article>

</section>


<section class="grid">

<article>

    <h2>🚨 Top IP attaquantes</h2>

    <div id="top"></div>

</article>


<article>

    <h2>🌐 Top pays</h2>

    <div id="topcountries"></div>

</article>

</section>


<section>

<article>

    <h2>🚫 Bans actifs</h2>

    <div id="bans"></div>

</article>

</section>


<section>

<article>

<h2>📋 Événements récents</h2>


<div class="table-wrap">

<table>

<thead>

<tr>
    <th>Type</th>
    <th>IP</th>
    <th>User</th>
    <th>Localisation</th>
    <th>FAI</th>
    <th>Date</th>
</tr>

</thead>


<tbody id="events"></tbody>

</table>

</div>

</article>

</section>


</main>

</div>


<div
    id="stream-modal"
    class="modal hidden"
>

<div class="modal-box">

<div class="section-header">

    <div>
        <h2>📡 Terminal SSH Live</h2>
        <span id="stream-info"></span>
    </div>

    <button onclick="closeStream()">
        ✕
    </button>

</div>


<pre id="stream-output">
Connexion au flux...
</pre>


<div class="stream-actions">

<button onclick="stopStream()">
    ⏹ Arrêter le flux
</button>

<button
    class="danger"
    onclick="killStreamSession()"
>
    💥 Kill session
</button>

</div>

</div>

</div>


<script src="/static/app.js"></script>

</body>

</html>
