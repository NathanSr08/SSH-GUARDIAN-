* {
    box-sizing: border-box;
}

html {
    color-scheme: dark;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    background:
        radial-gradient(
            circle at top right,
            rgba(55, 108, 255, 0.10),
            transparent 34%
        ),
        #080d14;
    color: #e7edf7;
}

button,
input {
    font: inherit;
}

.hidden {
    display: none !important;
}


/* =========================
   LOGIN
========================= */

.login {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 20px;
}

.login-box {
    width: min(420px, 100%);
    padding: 38px;
    background: rgba(17, 24, 36, 0.96);
    border: 1px solid #263247;
    border-radius: 20px;
    box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.38);
}

.login-box h1 {
    margin: 0 0 8px;
    font-size: 32px;
}

.login-box p {
    margin: 0 0 24px;
    color: #8ea0b8;
}

.login-box input {
    margin-bottom: 12px;
}

.login-box button {
    width: 100%;
}


/* =========================
   GENERAL
========================= */

input {
    width: 100%;
    padding: 11px 13px;
    background: #0a111b;
    color: #f5f8fc;
    border: 1px solid #2a3850;
    border-radius: 9px;
    outline: none;
}

input:focus {
    border-color: #557eff;
    box-shadow:
        0 0 0 3px rgba(85, 126, 255, 0.12);
}

button {
    padding: 10px 14px;
    border: 0;
    border-radius: 9px;
    cursor: pointer;
    color: white;
    background: #376df4;
    font-weight: 650;
    transition:
        transform 0.12s ease,
        opacity 0.12s ease;
}

button:hover {
    opacity: 0.9;
}

button:active {
    transform: scale(0.98);
}


/* =========================
   HEADER
========================= */

header {
    min-height: 82px;
    padding: 18px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    border-bottom: 1px solid #1d2939;
    background: rgba(8, 13, 20, 0.88);
    backdrop-filter: blur(12px);
    position: sticky;
    top: 0;
    z-index: 20;
}

header h1 {
    margin: 0;
    font-size: 26px;
}

.subtitle {
    display: inline-block;
    margin-top: 4px;
    color: #8091aa;
    font-size: 13px;
}

#global-status {
    padding: 9px 13px;
    border-radius: 999px;
    background: #101925;
    border: 1px solid #24334a;
    font-size: 13px;
}


/* =========================
   CONTENT
========================= */

main {
    max-width: 1600px;
    margin: 0 auto;
    padding: 28px;
}

section {
    margin-bottom: 20px;
}

article {
    background: rgba(17, 24, 36, 0.93);
    border: 1px solid #202d40;
    border-radius: 16px;
    padding: 20px;
    box-shadow:
        0 14px 34px rgba(0, 0, 0, 0.16);
}

article h2 {
    margin: 0 0 18px;
    font-size: 18px;
}


/* =========================
   STATS
========================= */

.stats {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(170px, 1fr));
    gap: 14px;
}

.stat {
    padding: 18px;
    background: linear-gradient(
        145deg,
        #111a27,
        #0d151f
    );
    border: 1px solid #213047;
    border-radius: 14px;
}

.stat span {
    color: #8395ad;
    font-size: 13px;
}

.stat strong {
    display: block;
    margin-top: 8px;
    font-size: 29px;
    letter-spacing: -0.8px;
}


/* =========================
   GRID
========================= */

.grid {
    display: grid;
    grid-template-columns:
        repeat(2, minmax(0, 1fr));
    gap: 20px;
}


/* =========================
   SERVICE STATUS
========================= */

.service {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    border-bottom: 1px solid #1b2636;
}

.service:last-child {
    border-bottom: 0;
}

.ok {
    color: #4ade80;
}

.bad {
    color: #fb7185;
}


/* =========================
   COUNTRIES
========================= */

.country-form {
    display: grid;
    grid-template-columns: 110px auto;
    gap: 8px;
    margin-bottom: 14px;
}

.tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 4px 5px 4px 0;
    padding: 7px 9px 7px 11px;
    border-radius: 999px;
    background: #1b293c;
    border: 1px solid #2a3a52;
    font-size: 13px;
}

.tag button {
    padding: 2px 7px;
    border-radius: 999px;
    background: #a83248;
}


/* =========================
   TOP
========================= */

.row {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding: 10px 0;
    border-bottom: 1px solid #1b2636;
}

.row:last-child {
    border-bottom: 0;
}

.row small {
    margin-left: 8px;
    color: #8193aa;
}


/* =========================
   BANS
========================= */

.ban {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 11px 0;
    border-bottom: 1px solid #1b2636;
}

.ban:last-child {
    border-bottom: 0;
}

.ban small {
    color: #899ab0;
}

.ban button {
    background: #b9374e;
}


/* =========================
   TABLE
========================= */

.table-wrap {
    overflow-x: auto;
    border: 1px solid #202d40;
    border-radius: 12px;
}

table {
    width: 100%;
    min-width: 900px;
    border-collapse: collapse;
}

thead {
    background: #101925;
}

th,
td {
    padding: 11px 13px;
    text-align: left;
    border-bottom: 1px solid #1c293b;
    white-space: nowrap;
}

th {
    color: #91a1b8;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.045em;
}

td {
    font-size: 13px;
}

tbody tr:hover {
    background: #101a27;
}


/* =========================
   RESPONSIVE
========================= */

@media (max-width: 900px) {
    header {
        padding: 16px;
    }

    main {
        padding: 16px;
    }

    .grid {
        grid-template-columns: 1fr;
    }

    .stats {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 520px) {
    .stats {
        grid-template-columns: 1fr;
    }

    header {
        align-items: flex-start;
        flex-direction: column;
    }
}


/* ==========================================
   SESSIONS
========================================== */

.section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.section-header h2 {
    margin: 0;
}

.session-card {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    align-items: center;

    padding: 14px 0;

    border-bottom:
        1px solid #1b2636;
}

.session-main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 15px;
}

.session-actions {
    display: flex;
    gap: 8px;
}

.danger {
    background: #b6374d;
}

.empty {
    color: #8191a6;
    padding: 12px 0;
}


/* ==========================================
   SEARCH
========================================== */

.search-form {
    display: flex;
    gap: 8px;
    margin-bottom: 18px;
}

.search-form input {
    max-width: 320px;
}

.search-list {
    max-height: 400px;
    overflow-y: auto;
}

.search-event {
    display: grid;

    grid-template-columns:
        minmax(190px, 1fr)
        minmax(220px, 1fr)
        1fr;

    gap: 12px;

    padding: 10px;

    border-bottom:
        1px solid #1b2636;
}


/* ==========================================
   STREAM MODAL
========================================== */

.modal {
    position: fixed;
    inset: 0;

    z-index: 1000;

    display: grid;
    place-items: center;

    padding: 20px;

    background:
        rgba(0, 0, 0, 0.76);

    backdrop-filter:
        blur(6px);
}

.modal-box {
    width:
        min(1200px, 96vw);

    height:
        min(800px, 92vh);

    display: flex;
    flex-direction: column;

    background:
        #080d13;

    border:
        1px solid #2b3b53;

    border-radius:
        16px;

    padding: 20px;

    box-shadow:
        0 30px 100px
        rgba(0, 0, 0, 0.55);
}

#stream-info {
    color: #8194ad;
}

#stream-output {
    flex: 1;

    margin: 18px 0;

    padding: 18px;

    overflow: auto;

    background:
        #030609;

    border:
        1px solid #253247;

    border-radius:
        10px;

    color:
        #d8f7df;

    font-family:
        "Cascadia Code",
        "JetBrains Mono",
        Consolas,
        monospace;

    font-size:
        13px;

    line-height:
        1.5;

    white-space:
        pre-wrap;
}

.stream-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
}


@media(max-width:700px) {

    .session-card {
        flex-direction: column;
        align-items: flex-start;
    }

    .search-event {
        grid-template-columns: 1fr;
    }

}
