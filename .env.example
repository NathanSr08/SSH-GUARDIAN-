# ============================================================
# SSH Guardian V2 - Exemple de configuration
# ============================================================
#
# Copier ce fichier :
#
#   cp .env.example .env
#
# Puis modifier :
#
#   nano .env
#
# ⚠️ Ne jamais commit le vrai fichier .env
# ============================================================


# ============================================================
# RUNTIME
# ============================================================

SG_STATE_DIR=/etc/ssh-guardian

SG_BLOCKED_COUNTRIES_FILE=/etc/ssh-guardian/blocked_countries.txt

SG_SESSION_LOG_DIR=/var/log/ssh_recorder


# ============================================================
# REDIS
# ============================================================

SG_REDIS_URL=redis://127.0.0.1:6379/0

SG_SSH_EVENTS_STREAM=ssh.events

SG_SSH_ENRICHED_STREAM=ssh.events.enriched

SG_SECURITY_ACTIONS_STREAM=security.actions

SG_FIREWALL_EVENTS_STREAM=firewall.events

SG_CONTROL_COMMANDS_STREAM=control.commands


# ============================================================
# SECURITY
# ============================================================

# Nombre de tentatives avant bannissement
SG_MAX_ATTEMPTS=3

# Durée du bannissement en secondes
# 86400 = 24 heures
SG_BAN_DURATION_SECONDS=86400


# ============================================================
# WHITELIST
# ============================================================
#
# Ajoute ici les IP qui ne doivent jamais être bannies.
#
# Exemple :
#
# SG_WHITELIST=127.0.0.1,::1,82.80.219.126
#

SG_WHITELIST=127.0.0.1,::1


# ============================================================
# FIREWALL
# ============================================================
#
# false = DRY-RUN
# true  = bannissement réel
#

SG_FIREWALL_ENABLED=false


# ============================================================
# GEOIP
# ============================================================

SG_GEOIP_CACHE_TTL=604800

SG_GEOIP_TIMEOUT=5


# ============================================================
# TELEGRAM
# ============================================================
#
# Créer un bot :
#
#   1. Ouvrir Telegram
#   2. Chercher @BotFather
#   3. Envoyer /newbot
#   4. Récupérer le token
#
# Ensuite envoyer /start au bot.
#
# Récupérer le Chat ID :
#
#   TOKEN="TON_TOKEN"
#
#   curl -s \
#     "https://api.telegram.org/bot${TOKEN}/getUpdates" \
#     | python3 -m json.tool
#
# Avec jq :
#
#   TOKEN="TON_TOKEN"
#
#   curl -s \
#     "https://api.telegram.org/bot${TOKEN}/getUpdates" \
#     | jq '.result[-1].message.chat.id'
#

SG_TELEGRAM_ENABLED=false

SG_TELEGRAM_TOKEN=

SG_TELEGRAM_CHAT_ID=


# ============================================================
# API
# ============================================================

SG_API_HOST=127.0.0.1

SG_API_PORT=8080


# ============================================================
# PANEL
# ============================================================

SG_PANEL_HOST=127.0.0.1

SG_PANEL_PORT=3000

SG_PANEL_API_URL=http://127.0.0.1:8080


# ============================================================
# TOKEN PANEL
# ============================================================
#
# install.sh peut générer automatiquement ce token.
#
# Pour en générer un manuellement :
#
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
#

SG_PANEL_TOKEN=
